SECURE_RAG_SOURCE_ROOT=C:\Data\Nextcloud
SECURE_RAG_CONFIG=config\app.yaml
HF_HOME=runtime\cache\models
# Privacy default: model loaders use only the already prepared local cache.
SECURE_RAG_HF_LOCAL_ONLY=1
SECURE_RAG_QDRANT_MODE=server
SECURE_RAG_QDRANT_URL=http://127.0.0.1:6333
SECURE_RAG_QDRANT_API_KEY=
SECURE_RAG_QDRANT_TIMEOUT_SECONDS=60
SECURE_RAG_QDRANT_WRITE_MAX_ATTEMPTS=3
SECURE_RAG_QDRANT_RETRY_BACKOFF_SECONDS=0.25

# Shared only by Open WebUI and the Universal RAG API. Generate independent random values;
# never give this backend key to browser users and never commit the real values.
SECURE_RAG_API_HOST=0.0.0.0
SECURE_RAG_API_PORT=8000
SECURE_RAG_API_KEY=replace-with-a-long-random-backend-key
# Server-side history is synchronized from Open WebUI and bounded before model use.
SECURE_RAG_CHAT_CONTEXT_MAX_MESSAGES=20
SECURE_RAG_CHAT_CONTEXT_MAX_CHARS=24000
SECURE_RAG_CHAT_STATE_MAX_MESSAGES=100
SECURE_RAG_CHAT_STATE_MAX_CHARS=500000
# Safe per-request pipeline events; files contain stage metadata, not document text.
# SECURE_RAG_PIPELINE_EVENT_DIR=runtime\diagnostics\pipeline-events
OPEN_WEBUI_SECRET_KEY=replace-with-a-different-long-random-session-key
OPEN_WEBUI_BIND_ADDRESS=0.0.0.0
OPEN_WEBUI_PORT=3000
OPEN_WEBUI_URL=http://SERVER-LAN-IP:3000
# Optional retrieval experiments without editing config/app.yaml.
# SECURE_RAG_RETRIEVAL_TOP_K=12
# SECURE_RAG_RETRIEVAL_HNSW_EF=512
# SECURE_RAG_RETRIEVAL_EXACT=false
# SECURE_RAG_PARENT_CONTEXT_ENABLED=true
# SECURE_RAG_WHOLE_DOCUMENT_MAX_CHARS=80000
# SECURE_RAG_LOGICAL_PARENT_MAX_CHARS=30000
# SECURE_RAG_TOTAL_CONTEXT_MAX_CHARS=180000
# Stores source-derived extracted text on disk; keep false unless retention is approved.
SECURE_RAG_PERSIST_EXTRACTED_CACHE=false
SECURE_RAG_PROVIDER=auto
OPENAI_API_KEY=
SECURE_RAG_OPENAI_MODEL=gpt-5-mini
# Optional override for the allowlisted external agent instruction workspace.
# SECURE_RAG_AGENT_WORKSPACE_ROOT=C:\Services\Universal-RAG-Agent
# Unsafe laboratory fallback only. Never enable for confidential source_root data:
# SECURE_RAG_PROVIDER=codex-local
# SECURE_RAG_ALLOW_UNSAFE_CODEX_LOCAL=1
# Save one visible Codex task per request in the workspace at llm.agent_workspace_root.
# All iterative retrieval turns for that request stay in the same task.
# SECURE_RAG_CODEX_PERSIST_THREADS=1
SECURE_RAG_CODEX_MODEL=gpt-5.6-luna
SECURE_RAG_NER_MODE=all
